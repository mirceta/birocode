<Project Sdk="Microsoft.NET.Sdk">

  <!-- Home bridge: a one-way forward proxy on the Hub (openspec home-bridge-proxy).
       Standalone on purpose: harness deploys and restarts never touch it. -->
  <PropertyGroup>
    <!-- WinExe: started at logon by a scheduled task, so no console window on the Hub's desktop. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HomeBridge</AssemblyName>
    <RootNamespace>HomeBridge</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Update="homebridge.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
